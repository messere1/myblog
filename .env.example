# Public site identity
NEXT_PUBLIC_SITE_URL=https://messere.cn

# Supabase Auth and existing public posts/categories
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Supabase PostgreSQL pooled connection string (server-only; never NEXT_PUBLIC_)
SUPABASE_DATABASE_URL=postgresql://postgres.project-ref:password@pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=5

# Generate a unique value of at least 32 characters in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional integrations
IMAGE_BED_TOKEN=
# GLM OpenAI-compatible API (server-only; never NEXT_PUBLIC_)
GLM_BASE_URL=https://glm.llm.autos
GLM_API_KEY=
GLM_MODEL=glm-5.3
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=3023209092@tju.edu.cn
SMTP_PASS=
MESSAGE_NOTIFY_TO=3023209092@tju.edu.cn
GITHUB_USERNAME=messere1

# Optional local fallback used by automated tests only
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
